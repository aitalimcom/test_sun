---
import AdminLayout from '../layouts/AdminLayout.astro';
---
<AdminLayout title="योजनाहरू" activePage="schemes">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h5 class="mb-1">कृषि योजनाहरू</h5>
      <p class="text-muted mb-0 small">सरकारी कृषि योजना र अनुदानहरू</p>
    </div>
    <button class="btn btn-success"><i class="bi bi-plus-circle me-1"></i> नयाँ योजना</button>
  </div>

  <div class="row g-4">
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="bg-success bg-opacity-10 rounded p-2"><i class="bi bi-seedling text-success fs-5"></i></div>
            <div>
              <h6 class="mb-0">बीउ अनुदान</h6>
              <small class="text-muted">कृषि मन्त्रालय</small>
            </div>
          </div>
          <p class="small text-muted">बीउ र बिजन खरिदमा अनुदान। प्रति किसान ₹५,००० सम्म।</p>
          <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-success">सक्रिय</span>
            <small class="text-muted">४५० लाभग्राही</small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="bg-primary bg-opacity-10 rounded p-2"><i class="bi bi-droplet text-primary fs-5"></i></div>
            <div>
              <h6 class="mb-0">सिँचाइ योजना</h6>
              <small class="text-muted">सिँचाइ विभाग</small>
            </div>
          </div>
          <p class="small text-muted">सिँचाइ पूर्वाधार निर्माणमा अनुदान। ५०% अनुदान।</p>
          <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-success">सक्रिय</span>
            <small class="text-muted">१२० लाभग्राही</small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="bg-warning bg-opacity-10 rounded p-2"><i class="bi bi-shield-check text-warning fs-5"></i></div>
            <div>
              <h6 class="mb-0">बीमा योजना</h6>
              <small class="text-muted">कृषि बीमा कार्यक्रम</small>
            </div>
          </div>
          <p class="small text-muted">बाली बीमा योजना। प्रिमियमको ८०% सरकारी अनुदान।</p>
          <div class="d-flex justify-content-between align-items-center">
            <span class="badge bg-warning text-dark">म्याद नजिक</span>
            <small class="text-muted">२०० लाभग्राही</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
