---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="किसान अभिलेख" activePage="farmer-records">
  <div class="mb-4">
    <a href="/farmer" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>फर्कनुहोस्</a>
    <div class="d-flex justify-content-between align-items-center mt-2">
      <div>
        <h5 class="mb-1">राम बहादुर श्रेष्ठ</h5>
        <p class="text-muted mb-0 small">ID: FRM-001 · काठमाडौं · धान</p>
      </div>
      <span class="badge bg-success fs-6">सक्रिय</span>
    </div>
  </div>

  <ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link active" href="#">सिंहावलोकन</a></li>
    <li class="nav-item"><a class="nav-link" href="#">योजना</a></li>
    <li class="nav-item"><a class="nav-link" href="#">इतिहास</a></li>
  </ul>

  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><h6 class="mb-0">व्यक्तिगत विवरण</h6></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-6"><small class="text-muted d-block">संपर्क नं.</small><span>9841XXXXXX</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">नागरिकता नं.</small><span>१२-३४-५६७८९</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">ठेगाना</small><span>काठमाडौं, बागमती</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">दर्ता मिति</small><span>२०८२-०३-१५</span></div>
          </div>
        </div>
      </div>
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><h6 class="mb-0">कृषि विवरण</h6></div>
        <div class="card-body">
          <div class="row g-3">
            <div class="col-sm-6"><small class="text-muted d-block">मुख्य बाली</small><span class="badge bg-success">धान</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">जमिन क्षेत्रफल</small><span>१५ विगा</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">सिँचाइ स्रोत</small><span>खोला</span></div>
            <div class="col-sm-6"><small class="text-muted d-block">वार्षिक उत्पादन</small><span>४.५ MT</span></div>
          </div>
        </div>
      </div>
      <div class="card shadow-sm">
        <div class="card-header bg-white"><h6 class="mb-0">दर्ता भएका योजनाहरू</h6></div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-sm mb-0">
              <thead><tr><th>योजना</th><th>अनुदान</th><th>मिति</th><th>स्थिति</th></tr></thead>
              <tbody>
                <tr><td>बीउ अनुदान</td><td>₹५,०००</td><td>२०८२-०२-१०</td><td><span class="badge bg-success">प्राप्त</span></td></tr>
                <tr><td>मल अनुदान</td><td>₹३,०००</td><td>२०८२-०१-२०</td><td><span class="badge bg-success">प्राप्त</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card shadow-sm mb-4">
        <div class="card-header bg-white"><h6 class="mb-0">सारांश</h6></div>
        <div class="card-body text-center">
          <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
            <i class="bi bi-person-check text-success fs-1"></i>
          </div>
          <h6>राम बहादुर श्रेष्ठ</h6>
          <p class="text-muted small mb-3">सक्रिय किसान</p>
          <div class="row g-2 text-center">
            <div class="col-6"><div class="bg-light rounded p-2"><small class="d-block text-muted">योजना</small><strong>२</strong></div></div>
            <div class="col-6"><div class="bg-light rounded p-2"><small class="d-block text-muted">अनुदान</small><strong>₹८K</strong></div></div>
          </div>
        </div>
      </div>
      <div class="card shadow-sm">
        <div class="card-body">
          <h6 class="mb-3">कार्यहरू</h6>
          <div class="d-grid gap-2">
            <button class="btn btn-outline-success btn-sm"><i class="bi bi-pencil me-1"></i> सम्पादन</button>
            <button class="btn btn-outline-primary btn-sm"><i class="bi bi-printer me-1"></i> प्रिन्ट</button>
            <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash me-1"></i> मेटाउनुहोस्</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
