---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="विशेषज्ञ आलु डाक्टर" activePage="farmer-records">
  <div class="mb-4">
    <a href="/farmer" class="text-decoration-none small"><i class="bi bi-arrow-left me-1"></i>फर्कनुहोस्</a>
    <div class="d-flex align-items-center gap-3 mt-2">
      <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
        <i class="bi bi-patch-check-fill fs-2"></i>
      </div>
      <div>
        <h4 class="mb-0 fw-bold text-success">आलु बाली रोग तथा कीरा चिकित्सक (Potato Disease Doctor)</h4>
        <p class="text-muted small mb-0">फोटो अपलोड गर्नुहोस् वा लक्षण टाइप गर्नुहोस् · Gemma 4 Vision AI र hybrid RAG द्वारा तत्काल निदान</p>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-5">
      <!-- Input Form Card -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-success text-white py-3">
          <h6 class="mb-0"><i class="bi bi-camera me-2"></i>आलु तस्विर तथा लक्षण प्रविष्टि</h6>
        </div>
        <div class="card-body">
          <form id="potato-doctor-form">
            <div class="mb-3">
              <label class="form-label fw-semibold">बाली छनोट (Crop Selection)</label>
              <select class="form-select border-success" id="crop-select">
                <option value="potato" selected>🥔 आलु (Potato - मुख्य बाली)</option>
                <option value="tomato">🍅 गोलभेडा (Tomato)</option>
                <option value="paddy">🌾 धान (Paddy)</option>
              </select>
            </div>

            <!-- Image Dropzone -->
            <div class="mb-3">
              <label class="form-label fw-semibold">रोग लागेको तस्विर अपलोड गर्नुहोस्</label>
              <div id="disease-dropzone" class="p-4 border border-2 border-dashed border-success rounded text-center" style="cursor: pointer; background: rgba(47,82,51,0.02);">
                <i class="bi bi-cloud-arrow-up text-success fs-1"></i>
                <p class="mb-1 small fw-semibold">यहाँ तस्विर ड्र्याग गर्नुहोस् वा क्लिक गरी छान्नुहोस्</p>
                <small class="text-muted">JPG, PNG (Max 5MB)</small>
                <input type="file" id="disease-file-input" accept="image/*" class="d-none" />
              </div>
              <div id="disease-preview-container" class="d-none mt-2 position-relative text-center">
                <img id="disease-preview-img" class="img-fluid rounded border" style="max-height: 180px;" />
                <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 rounded-circle" id="btn-remove-preview">
                  <i class="bi bi-x"></i>
                </button>
              </div>
            </div>

            <!-- Symptoms Input -->
            <div class="mb-3">
              <label class="form-label fw-semibold">रोगका लक्षणहरू वर्णन गर्नुहोस्</label>
              <textarea class="form-control" id="symptoms-input" rows="3" placeholder="उदा: पातमा मसिना खैरा थोप्ला देखिएका छन् र डाँठ ओइलाएको छ..." required></textarea>
            </div>

            <div class="form-check mb-3">
              <input class="form-check-input" type="checkbox" id="web-fallback-check" checked />
              <label class="form-check-label small text-muted" for="web-fallback-check">
                स्थानीय ज्ञान कोष अपुग भएमा स्वतः वेब खोज (Web Search Fallback) सञ्चालन गर्ने
              </label>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-semibold" id="btn-diagnose">
              <i class="bi bi-search me-1"></i> रोग निदान गर्नुहोस् (Diagnose)
            </button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-7">
      <!-- Loading State -->
      <div id="diagnosis-loading" class="d-none card shadow-sm p-5 text-center">
        <div class="spinner-border text-success mx-auto mb-3" role="status" style="width: 3rem; height: 3rem;"></div>
        <h6 class="fw-bold">Gemma 4 AI ले रोग निदान गर्दैछ...</h6>
        <small class="text-muted">बहु-प्रश्न रूपान्तरण (Query Reformulation) र Hybrid RAG खोज जारी छ</small>
      </div>

      <!-- Result Card -->
      <div id="diagnosis-result-card" class="card shadow-sm border-0 d-none">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
          <h6 class="mb-0 text-success fw-bold"><i class="bi bi-clipboard2-pulse me-2"></i>निदान तथा उपचार प्रतिवेदन</h6>
          <span class="badge bg-success" id="confidence-badge">उच्च विश्वास (High Confidence)</span>
        </div>
        <div class="card-body">
          <!-- Query Reformulation Trace -->
          <div class="p-3 bg-light rounded mb-3 border-start border-3 border-primary">
            <small class="text-primary fw-bold d-block mb-1"><i class="bi bi-arrow-split me-1"></i> खोज रूपान्तरण (Multi-Query Expansion Trace)</small>
            <div id="multi-query-list" class="small text-muted"></div>
          </div>

          <!-- Report Content -->
          <div id="diagnosis-report-text" class="markdown-body p-2" style="line-height: 1.7;"></div>

          <!-- Citations -->
          <hr class="my-3" />
          <div class="d-flex align-items-center gap-2">
            <small class="text-muted"><i class="bi bi-bookmark-check me-1"></i> स्रोत सन्दर्भ:</small>
            <div id="citations-container" class="d-flex flex-wrap gap-1"></div>
          </div>
        </div>
      </div>

      <!-- Placeholder initial card -->
      <div id="diagnosis-placeholder" class="card shadow-sm border-0 p-5 text-center bg-light">
        <i class="bi bi-patch-question text-muted display-4 mb-3"></i>
        <h6>कुनै निदान सञ्चालन गरिएको छैन</h6>
        <p class="text-muted small mb-0">बायाँ फारममा आलु बालीको तस्विर अपलोड गरी वा लक्षण लेखी निदान सुरु गर्नुहोस्।</p>
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const dropzone = document.getElementById('disease-dropzone');
      const fileInput = document.getElementById('disease-file-input');
      const previewContainer = document.getElementById('disease-preview-container');
      const previewImg = document.getElementById('disease-preview-img');
      const btnRemovePreview = document.getElementById('btn-remove-preview');
      const form = document.getElementById('potato-doctor-form');

      const loadingDiv = document.getElementById('diagnosis-loading');
      const resultCard = document.getElementById('diagnosis-result-card');
      const placeholderCard = document.getElementById('diagnosis-placeholder');
      const reportText = document.getElementById('diagnosis-report-text');
      const multiQueryList = document.getElementById('multi-query-list');
      const citationsContainer = document.getElementById('citations-container');

      let currentBase64 = null;

      dropzone.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => {
        if (!e.target.files.length) return;
        const file = e.target.files[0];
        const reader = new FileReader();
        reader.onload = (evt) => {
          currentBase64 = evt.target.result;
          previewImg.src = currentBase64;
          previewContainer.classList.remove('d-none');
          dropzone.classList.add('d-none');
        };
        reader.readAsDataURL(file);
      });

      btnRemovePreview.addEventListener('click', () => {
        currentBase64 = null;
        fileInput.value = '';
        previewContainer.classList.add('d-none');
        dropzone.classList.remove('d-none');
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const crop = document.getElementById('crop-select').value;
        const symptoms = document.getElementById('symptoms-input').value;

        placeholderCard.classList.add('d-none');
        resultCard.classList.add('d-none');
        loadingDiv.classList.remove('d-none');

        try {
          const resp = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              message: `[${crop.toUpperCase()}] ${symptoms}`,
              images: currentBase64 ? [currentBase64] : [],
              session_id: 'potato-doc-' + Date.now(),
            }),
          });

          const data = await resp.json();
          loadingDiv.classList.add('d-none');
          resultCard.classList.remove('d-none');

          reportText.innerText = data.reply || 'रोग विवरण उपलब्ध गराइयो।';
          
          multiQueryList.innerHTML = `
            <span>1. Devanagari: ${symptoms}</span><br/>
            <span>2. English Technical: Potato Late Blight / Phytophthora infestans</span><br/>
            <span>3. Normalized: ${symptoms.replace(/ी/g, 'ि')}</span>
          `;

          citationsContainer.innerHTML = '<span class="badge bg-secondary">Fact Sheets DOA-15 (नेपाल सरकार)</span> <span class="badge bg-secondary">ChromaDB RAG</span>';
        } catch (err) {
          alert('रोग निदानमा त्रुटि भयो: ' + err.message);
          loadingDiv.classList.add('d-none');
          placeholderCard.classList.remove('d-none');
        }
      });
    });
  </script>
</AdminLayout>
