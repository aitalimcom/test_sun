---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="उपकरण विवरण तथा नियन्त्रण" activePage="iot">
  <div class="mb-4">
    <a href="/iot" class="text-decoration-none small text-secondary">
      <i class="bi bi-arrow-left me-1"></i>IoT स्टेसन सूचीमा फर्कनुहोस्
    </a>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mt-2 gap-3">
      <div>
        <h4 class="mb-1 fw-bold text-success" id="device-name">उपकरण विवरण लोड हुँदैछ...</h4>
        <p class="text-muted mb-0 small" id="device-meta">कृपया पर्खनुहोस्</p>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-outline-success btn-sm shadow-sm" onclick="syncDevice()">
          <i class="bi bi-arrow-clockwise me-1"></i> Data Sync
        </button>
        <button class="btn btn-outline-danger btn-sm shadow-sm" onclick="deleteDevice()">
          <i class="bi bi-trash me-1"></i> उपकरण हटाउनुहोस्
        </button>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Sensors, Actuators & Telemetry -->
    <div class="col-lg-8">
      <!-- Sensor Gauges Card -->
      <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-speedometer2 me-2 text-primary"></i>वास्तविक समय डेटा (Live Sensor Readings)</h6>
          <small class="text-muted" id="last-sync">-</small>
        </div>
        <div class="card-body">
          <div class="row g-3" id="sensor-gauges">
            <div class="col-12 text-center py-4">
              <div class="spinner-border text-success" role="status"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Actuator Controls Panel -->
      <div class="card shadow-sm border-0 mb-4 rounded-3" id="actuator-panel">
        <div class="card-header bg-white py-3">
          <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-sliders me-2 text-success"></i>डिजिटल एक्चुएटर नियन्त्रण स्विच (Actuator Control Panel)</h6>
        </div>
        <div class="card-body" id="actuator-controls">
          <p class="text-muted small mb-0">लोड हुँदैछ...</p>
        </div>
      </div>

      <!-- Live Telemetry History -->
      <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-graph-up me-2 text-info"></i>टेलिमेट्री इतिहास (Telemetry History CSV)</h6>
          <span class="badge bg-light text-dark border">२। पल्टका डेटा</span>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
              <thead class="table-light text-secondary small">
                <tr id="telemetry-header">
                  <th class="ps-3">समय (Timestamp)</th>
                </tr>
              </thead>
              <tbody id="telemetry-body" class="small">
                <tr><td colspan="10" class="text-center py-3 text-muted">डेटा प्राप्त हुँदैछ...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Device-Wise Control Chat, Alerts & Schedules -->
    <div class="col-lg-4">
      <!-- Device Quick Info -->
      <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-body text-center p-4">
          <div class="bg-success-subtle text-success rounded-circle d-inline-flex p-3 mb-3">
            <i class="bi bi-router fs-1"></i>
          </div>
          <h5 class="mb-1 fw-bold" id="info-name">-</h5>
          <p class="text-muted small mb-3" id="info-type">-</p>
          <div class="row g-2 text-start bg-light p-3 rounded-3 small">
            <div class="col-6"><small class="text-muted d-block">स्थान:</small><span class="fw-semibold text-dark" id="info-location">-</span></div>
            <div class="col-6"><small class="text-muted d-block">स्थिति:</small><span id="info-status">-</span></div>
            <div class="col-6"><small class="text-muted d-block">ब्याट्री:</small><span class="fw-semibold text-dark" id="info-battery">-</span></div>
            <div class="col-6"><small class="text-muted d-block">उपकरण ID:</small><small class="font-monospace text-dark" id="info-id">-</small></div>
          </div>
        </div>
      </div>

      <!-- Device-Wise AI Control Assistant -->
      <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-header bg-success text-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold fs-6"><i class="bi bi-robot me-2"></i>एजेन्ट नियन्त्रण सहायक</h6>
          <small class="badge bg-white text-success">Gemma 4</small>
        </div>
        <div class="card-body p-3">
          <div id="control-messages" style="height: 260px; overflow-y: auto;" class="mb-3 p-2 bg-light rounded border small">
            <div class="alert alert-info small mb-0 py-2">
              <i class="bi bi-info-circle me-1"></i> आदेश दिनुहोस्। उदाहरण: "सिँचाइ पम्प ३० मिनेटका लागि चालु गर" वा "तापक्रम ३५°C नाघेमा सतर्क गराऊ"
            </div>
          </div>
          <div class="input-group input-group-sm">
            <input type="text" class="form-control" id="control-input" placeholder="आदेश लेख्नुहोस्..." onkeydown="if(event.key==='Enter')sendControlChat()" />
            <button class="btn btn-success" onclick="sendControlChat()">
              <i class="bi bi-send-fill"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Schedules List -->
      <div class="card shadow-sm border-0 mb-4 rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar-check me-2 text-warning"></i>समयतालिका (Schedules)</h6>
          <button class="btn btn-sm btn-outline-success" onclick="showAddSchedule()">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
        <div class="card-body p-0" id="schedules-list">
          <div class="text-center py-3 small text-muted">कुनै समयतालिका छैन</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Schedule Modal -->
  <div class="modal fade" id="scheduleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg">
        <div class="modal-header bg-success text-white">
          <h6 class="modal-title fw-bold"><i class="bi bi-clock me-2"></i>समयतालिका थप्नुहोस् (Add Task Schedule)</h6>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-semibold">एक्शन (Action)</label>
            <select class="form-select form-select-sm" id="sch-action">
              <option value="start_pump">सिँचाइ पम्प चालु (Start Pump)</option>
              <option value="stop_pump">सिँचाइ पम्प बन्द (Stop Pump)</option>
              <option value="fan_on">ग्रीनहाउस पंखा चालु (Fan On)</option>
              <option value="fan_off">ग्रीनहाउस पंखा बन्द (Fan Off)</option>
              <option value="valve_open">भल्भ खोल्नुहोस् (Open Valve)</option>
              <option value="valve_close">भल्भ बन्द गर्नुहोस् (Close Valve)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">CRON Expression *</label>
            <input type="text" class="form-control form-control-sm font-monospace" id="sch-cron" value="0 6 * * *" />
            <small class="text-muted d-block mt-1">उदाहरण: "0 6 * * *" (हरेक बिहान ६:०० बजे)</small>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">अवधि (Minutes)</label>
            <input type="number" class="form-control form-control-sm" id="sch-duration" value="30" />
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button class="btn btn-sm btn-secondary" data-bs-dismiss="modal">रद्द</button>
          <button class="btn btn-sm btn-success" onclick="addSchedule()">सुरक्षित गर्नुहोस्</button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    // Get device ID dynamically from query param ?id=... or fallback path
    const urlParams = new URLSearchParams(window.location.search);
    const pathId = window.location.pathname.split('/iot/')[1]?.split('?')[0];
    const deviceId = urlParams.get('id') || (pathId && pathId !== 'device' ? pathId : 'weather-001');

    const API = '/api/iot';
    let deviceData = null;

    // Load LocalStorage Device-Wise Chat History
    const chatStorageKey = `iot_chat_${deviceId}`;
    let controlChatHistory = JSON.parse(localStorage.getItem(chatStorageKey) || '[]');

    async function loadDevice() {
      try {
        const resp = await fetch(`${API}/devices/${deviceId}`);
        if (!resp.ok) throw new Error('Device not found');
        const data = await resp.json();
        deviceData = data.device;
        renderDeviceInfo(deviceData);
        await loadTelemetry();
        await loadSchedules();
        renderChatHistory();
      } catch (e) {
        document.getElementById('device-name').textContent = `उपकरण फेला परेन (${deviceId})`;
        console.error(e);
      }
    }

    function renderDeviceInfo(d) {
      document.getElementById('device-name').textContent = d.name;
      document.getElementById('device-meta').textContent = `${d.device_type.toUpperCase()} — स्थान: ${d.location}`;
      document.getElementById('info-name').textContent = d.name;
      document.getElementById('info-type').textContent = d.device_type;
      document.getElementById('info-location').textContent = d.location;
      document.getElementById('info-status').innerHTML = `<span class="badge bg-${d.status === 'active' ? 'success' : 'secondary'}">${d.status}</span>`;
      document.getElementById('info-battery').textContent = `${d.battery}%`;
      document.getElementById('info-id').textContent = d.device_id;
      
      renderSensorGauges(d, d.latest);
      renderActuatorControls(d);
    }

    function renderSensorGauges(d, latest) {
      let sensors = [];
      try {
        sensors = typeof d.sensors_json === 'string' ? JSON.parse(d.sensors_json) : (d.sensors || []);
      } catch(e) { sensors = []; }

      if (!sensors || !sensors.length) {
        document.getElementById('sensor-gauges').innerHTML = '<div class="col-12 text-center text-muted py-3">कुनै सेन्सर कन्फिगर गरिएको छैन।</div>';
        return;
      }

      const sensorInfo = {
        temperature: { icon: 'bi-thermometer-half', color: 'danger', label: 'तापक्रम (Temp)', unit: '°C' },
        humidity: { icon: 'bi-droplet', color: 'primary', label: 'आद्रता (Humidity)', unit: '%' },
        co2: { icon: 'bi-cloud', color: 'secondary', label: 'CO2 लेभल', unit: 'ppm' },
        moisture: { icon: 'bi-moisture', color: 'success', label: 'माटोको ओस (Moisture)', unit: '%' },
        ph: { icon: 'bi-droplet-half', color: 'info', label: 'pH मान', unit: '' },
        light: { icon: 'bi-brightness-high', color: 'warning', label: 'प्रकाश (Light)', unit: 'lux' },
        pressure: { icon: 'bi-cloud-hail', color: 'dark', label: 'वातावरणीय चाप', unit: 'hPa' },
        rainfall: { icon: 'bi-cloud-rain', color: 'info', label: 'वर्षा (Rain)', unit: 'mm' },
      };

      document.getElementById('sensor-gauges').innerHTML = sensors.map(s => {
        const info = sensorInfo[s] || { icon: 'bi-cpu', color: 'secondary', label: s, unit: '' };
        const val = latest && latest[s] !== undefined ? latest[s] : '--';
        return `
          <div class="col-md-4 col-6">
            <div class="text-center p-3 bg-light rounded-3 border border-light-subtle">
              <i class="bi ${info.icon} text-${info.color} fs-3"></i>
              <h4 class="mb-0 mt-1 fw-bold text-dark">${val}</h4>
              <small class="text-muted d-block mt-1">${info.label} ${info.unit ? `(${info.unit})` : ''}</small>
            </div>
          </div>`;
      }).join('');

      if (latest && latest.timestamp) {
        document.getElementById('last-sync').textContent = 'अन्तिम सिङ्क: ' + new Date(latest.timestamp).toLocaleTimeString();
      }
    }

    function renderActuatorControls(d) {
      let actuators = [];
      let config = {};
      try {
        actuators = typeof d.actuators_json === 'string' ? JSON.parse(d.actuators_json) : (d.actuators || []);
        config = typeof d.config_json === 'string' ? JSON.parse(d.config_json) : (d.config || {});
      } catch(e) {}

      const states = config.actuators_state || {};

      if (!actuators || !actuators.length) {
        actuators = ['pump', 'fan', 'valve']; // Default fallbacks
      }

      const actInfo = {
        pump: { icon: 'bi-moisture', label: 'सिँचाइ पम्प (Irrigation Pump)', type: 'toggle' },
        ac: { icon: 'bi-thermometer-snow', label: 'AC कुलर', type: 'range', min: 15, max: 40 },
        light: { icon: 'bi-lightbulb', label: 'ग्रीनहाउस लाइट', type: 'toggle' },
        fan: { icon: 'bi-fan', label: 'भेन्टिलेसन पंखा', type: 'toggle' },
        valve: { icon: 'bi-valve', label: 'पानी भल्भ (Water Valve)', type: 'toggle' },
        heater: { icon: 'bi-fire', label: 'हीटर', type: 'range', min: 15, max: 45 },
      };

      document.getElementById('actuator-controls').innerHTML = '<div class="row g-3">' + actuators.map(a => {
        const info = actInfo[a] || { icon: 'bi-cpu', label: a, type: 'toggle' };
        const isChecked = states[a] === 'on' || states[a] === 'open';

        if (info.type === 'toggle') {
          return `
            <div class="col-md-6">
              <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3 border">
                <span class="fw-semibold text-dark"><i class="bi ${info.icon} me-2 text-success"></i>${info.label}</span>
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" ${isChecked ? 'checked' : ''} onchange="toggleActuator('${a}', this.checked)" />
                </div>
              </div>
            </div>`;
        } else {
          const val = states[a] || 25;
          return `
            <div class="col-12">
              <div class="p-3 bg-light rounded-3 border">
                <label class="form-label small fw-semibold d-flex justify-content-between">
                  <span><i class="bi ${info.icon} me-2 text-warning"></i>${info.label}</span>
                  <span class="badge bg-dark">${val}°C</span>
                </label>
                <input type="range" class="form-range" min="${info.min}" max="${info.max}" value="${val}"
                       onchange="setActuatorValue('${a}', this.value)" />
              </div>
            </div>`;
        }
      }).join('') + '</div>';
    }

    async function toggleActuator(actuator, on) {
      try {
        await fetch(`/api/cms/iot/devices/${deviceId}/actuator`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ actuator, state: on ? 'on' : 'off' }),
        });
        await loadDevice();
      } catch (e) {
        console.error("Actuator error:", e);
      }
    }

    async function loadTelemetry() {
      try {
        const resp = await fetch(`${API}/device/${deviceId}/telemetry?limit=15`);
        const data = await resp.json();
        renderTelemetry(data.telemetry || []);
      } catch (e) {
        console.error(e);
      }
    }

    function renderTelemetry(rows) {
      if (!rows.length) {
        document.getElementById('telemetry-header').innerHTML = '<th class="ps-3">समय</th><th>डेटा अप्राप्त</th>';
        document.getElementById('telemetry-body').innerHTML = '<tr><td colspan="10" class="text-center py-3 text-muted">कुनै टेलिमेट्री रेकर्ड छैन। Data Sync मा थिच्नुहोस्।</td></tr>';
        return;
      }
      const keys = Object.keys(rows[0]).filter(k => k !== 'timestamp');
      document.getElementById('telemetry-header').innerHTML = '<th class="ps-3">समय</th>' + keys.map(k => `<th>${k}</th>`).join('');
      document.getElementById('telemetry-body').innerHTML = rows.slice().reverse().map(r => {
        return `<tr><td class="ps-3"><small class="font-monospace">${r.timestamp ? new Date(r.timestamp).toLocaleTimeString() : '-'}</small></td>` +
          keys.map(k => `<td><span class="badge bg-light text-dark border">${r[k] !== undefined ? r[k] : '-'}</span></td>`).join('') + '</tr>';
      }).join('');
    }

    async function syncDevice() {
      try {
        const resp = await fetch(`${API}/device/${deviceId}/sync`, { method: 'POST' });
        await loadDevice();
        alert('डेटा सफलतापूर्वक सिङ्क गरियो!');
      } catch (e) {
        alert('सिङ्क असफल: ' + e.message);
      }
    }

    async function deleteDevice() {
      if (!confirm('के तपाईं निश्चित हुनुहुन्छ यो उपकरण हटाउन चाहनुहुन्छ?')) return;
      await fetch(`/api/cms/iot/devices/${deviceId}`, { method: 'DELETE' });
      window.location = '/iot';
    }

    // ── Device-Wise Control Chat ──
    function renderChatHistory() {
      const el = document.getElementById('control-messages');
      if (controlChatHistory.length === 0) return;
      
      el.innerHTML = controlChatHistory.map(m => `
        <div class="mb-2 ${m.role === 'user' ? 'text-end' : 'text-start'}">
          <span class="badge ${m.role === 'user' ? 'bg-success' : 'bg-white text-dark border text-wrap text-start shadow-sm'} p-2">
            ${m.content}
          </span>
        </div>
      `).join('');
      el.scrollTop = el.scrollHeight;
    }

    async function sendControlChat() {
      const input = document.getElementById('control-input');
      const msg = input.value.trim();
      if (!msg) return;
      input.value = '';

      controlChatHistory.push({ role: 'user', content: msg });
      localStorage.setItem(chatStorageKey, JSON.stringify(controlChatHistory.slice(-20)));
      renderChatHistory();

      const el = document.getElementById('control-messages');
      el.innerHTML += `<div class="mb-2" id="ctrl-loading"><div class="spinner-border spinner-border-sm text-success"></div></div>`;

      try {
        const resp = await fetch(`${API}/chat/control/${deviceId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: msg, history: controlChatHistory.slice(-10) }),
        });
        const result = await resp.json();
        document.getElementById('ctrl-loading')?.remove();

        const reply = result.reply || 'कार्य पूरा भयो!';
        controlChatHistory.push({ role: 'assistant', content: reply });
        localStorage.setItem(chatStorageKey, JSON.stringify(controlChatHistory.slice(-20)));
        
        renderChatHistory();
        await loadDevice();
      } catch (e) {
        document.getElementById('ctrl-loading')?.remove();
        controlChatHistory.push({ role: 'assistant', content: 'त्रुटि: एजेन्टसँग सम्पर्क हुन सकेन।' });
        renderChatHistory();
      }
    }

    // ── Schedules ──
    async function loadSchedules() {
      try {
        const resp = await fetch(`${API}/schedules?device_id=${deviceId}`);
        const data = await resp.json();
        renderSchedules(data.schedules || []);
      } catch (e) {
        console.error(e);
      }
    }

    function renderSchedules(schedules) {
      const el = document.getElementById('schedules-list');
      if (!schedules.length) {
        el.innerHTML = '<div class="text-center py-3 small text-muted">कुनै समयतालिका छैन</div>';
        return;
      }
      el.innerHTML = schedules.map(s => `
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
          <div>
            <p class="mb-0 small fw-semibold text-dark">${s.action}</p>
            <small class="text-muted font-monospace">${s.cron_expr}</small>
          </div>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteSchedule('${s.schedule_id}')">
            <i class="bi bi-trash"></i>
          </button>
        </div>`).join('');
    }

    function showAddSchedule() {
      new bootstrap.Modal(document.getElementById('scheduleModal')).show();
    }

    async function addSchedule() {
      const action = document.getElementById('sch-action').value;
      const cron = document.getElementById('sch-cron').value;
      const duration = parseInt(document.getElementById('sch-duration').value);
      await fetch(`${API}/schedules`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ device_id: deviceId, action, cron_expr: cron, params: { duration_min: duration } }),
      });
      bootstrap.Modal.getInstance(document.getElementById('scheduleModal')).hide();
      loadSchedules();
    }

    async function deleteSchedule(id) {
      await fetch(`${API}/schedules/${id}`, { method: 'DELETE' });
      loadSchedules();
    }

    // Initial Load & Auto-Refresh
    loadDevice();
    setInterval(loadDevice, 20000);
  </script>
</AdminLayout>
