---
interface Props {
  title: string;
  activePage?: string;
}
const { title, activePage = '' } = Astro.props;
---
<!doctype html>
<html lang="ne" data-bs-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1a1a2e" />
  <title>{title} | कृषि सेवा</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <style>
    :root {
      --sidebar-bg: #0f1923;
      --sidebar-hover: #1a2a3a;
      --sidebar-active: #1e3a2f;
      --topbar-bg: #151e27;
      --body-bg: #0d1117;
      --card-bg: #161b22;
      --card-border: #21262d;
      --text-primary: #e6edf3;
      --text-secondary: #8b949e;
      --accent: #2ea043;
      --accent-hover: #3fb950;
    }
    body { font-family: 'Inter', system-ui, sans-serif; background: var(--body-bg); color: var(--text-primary); }
    .sidebar { width: 260px; min-height: 100vh; background: var(--sidebar-bg); color: #fff; position: fixed; top: 0; left: 0; z-index: 1000; transition: transform 0.3s; overflow-y: auto; border-right: 1px solid var(--card-border); }
    .sidebar-brand { padding: 1rem 1.25rem; font-size: 1.25rem; font-weight: 700; border-bottom: 1px solid var(--card-border); }
    .sidebar-nav { list-style: none; padding: 0; margin: 0; }
    .sidebar-nav li a { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 1.25rem; color: var(--text-secondary); text-decoration: none; transition: all 0.2s; font-size: 0.9rem; }
    .sidebar-nav li a:hover, .sidebar-nav li a.active { background: var(--sidebar-hover); color: #fff; }
    .sidebar-nav li a.active { background: var(--sidebar-active); border-left: 3px solid var(--accent); }
    .sidebar-nav li a i { width: 20px; text-align: center; }
    .sidebar-section { padding: 0.5rem 1.25rem 0.25rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); opacity: 0.6; }
    .sidebar-accordion .accordion-button { background: transparent; color: var(--text-secondary); border: none; padding: 0.65rem 1.25rem; font-size: 0.9rem; box-shadow: none; }
    .sidebar-accordion .accordion-button:not(.collapsed) { color: #fff; background: var(--sidebar-hover); }
    .sidebar-accordion .accordion-button::after { filter: invert(1); opacity: 0.5; }
    .sidebar-accordion .accordion-body { padding: 0 0 0.25rem; }
    .sidebar-accordion .accordion-body a { display: flex; align-items: center; gap: 0.75rem; padding: 0.5rem 1.25rem 0.5rem 2.5rem; color: var(--text-secondary); text-decoration: none; transition: all 0.2s; font-size: 0.85rem; }
    .sidebar-accordion .accordion-body a:hover, .sidebar-accordion .accordion-body a.active { color: #fff; background: var(--sidebar-hover); }
    .main-content { margin-left: 260px; padding-top: 60px; min-height: 100vh; }
    .topbar { height: 60px; background: var(--topbar-bg); border-bottom: 1px solid var(--card-border); display: flex; align-items: center; padding: 0 1.5rem; position: fixed; top: 0; right: 0; left: 260px; z-index: 999; }
    .stat-card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 0.75rem; transition: transform 0.2s; }
    .stat-card:hover { transform: translateY(-2px); border-color: var(--accent); }
    .card { background: var(--card-bg); border: 1px solid var(--card-border); border-radius: 0.75rem; }
    .card-header { background: transparent; border-bottom: 1px solid var(--card-border); }
    .table { color: var(--text-primary); }
    .table-light, .table > thead { --bs-table-bg: #161b22; --bs-table-color: var(--text-primary); }
    .form-control, .form-select { background: #0d1117; border-color: var(--card-border); color: var(--text-primary); }
    .form-control:focus, .form-select:focus { background: #0d1117; border-color: var(--accent); color: #fff; box-shadow: 0 0 0 0.2rem rgba(46,160,67,0.25); }
    .form-check-input:checked { background-color: var(--accent); border-color: var(--accent); }
    .btn-outline-success { border-color: var(--accent); color: var(--accent); }
    .btn-outline-success:hover { background: var(--accent); color: #fff; }
    .bg-light { background-color: #161b22 !important; }
    .text-muted { color: var(--text-secondary) !important; }
    .dropdown-menu { background: var(--card-bg); border: 1px solid var(--card-border); }
    .dropdown-item { color: var(--text-primary); }
    .dropdown-item:hover { background: var(--sidebar-hover); color: #fff; }
    .modal-content { background: var(--card-bg); border: 1px solid var(--card-border); }
    .modal-header { border-bottom-color: var(--card-border); }
    .modal-footer { border-top-color: var(--card-border); }
    .badge.bg-light { background: #21262d !important; color: var(--text-primary); }
    .list-group-item { background: var(--card-bg); border-color: var(--card-border); color: var(--text-primary); }
    .accordion-item { background: transparent; border-color: transparent; }
    .spinner-border { border-color: var(--accent); border-right-color: transparent; }
    .bg-white { background-color: var(--card-bg) !important; }
    pre { background: #0d1117 !important; border: 1px solid var(--card-border); }
    @media (max-width: 991.98px) { .sidebar { transform: translateX(-100%); } .sidebar.show { transform: translateX(0); } .main-content { margin-left: 0; } .topbar { left: 0; } }
  </style>
</head>
<body>
  <aside class="sidebar d-none d-lg-flex flex-column" id="sidebar">
    <div class="sidebar-brand d-flex align-items-center gap-2">
      <i class="bi bi-leaf-fill text-success fs-4"></i>
      <span>कृषि सेवा</span>
    </div>
    <nav class="mt-3">
      <ul class="sidebar-nav">
        <li><a href="/" class={activePage === 'dashboard' ? 'active' : ''}><i class="bi bi-grid-1x2"></i> ड्यासबोर्ड</a></li>
      </ul>

      <div class="sidebar-section">किसान व्यवस्थापन</div>
      <div class="sidebar-accordion accordion" id="farmerAccordion">
        <div class="accordion-item bg-transparent border-0">
          <h2 class="accordion-header">
            <button class="accordion-button py-2" type="button" data-bs-toggle="collapse" data-bs-target="#farmerMenu"
                    aria-expanded={activePage.startsWith('farmer') || activePage.startsWith('iot') ? 'true' : 'false'}>
              <i class="bi bi-person-workspace me-2"></i> किसान
            </button>
          </h2>
          <div id="farmerMenu" class={`accordion-collapse collapse ${activePage.startsWith('farmer') || activePage.startsWith('iot') ? 'show' : ''}`} data-bs-parent="#farmerAccordion">
            <div class="accordion-body">
              <a href="/farmer" class={activePage === 'farmer' ? 'active' : ''}><i class="bi bi-people"></i> किसान सूची</a>
              <a href="/farmer/register" class={activePage === 'farmer-register' ? 'active' : ''}><i class="bi bi-person-plus"></i> दर्ता</a>
              <a href="/farmer/records" class={activePage === 'farmer-records' ? 'active' : ''}><i class="bi bi-journal-text"></i> अभिलेख</a>
            </div>
          </div>
        </div>
      </div>

      <div class="sidebar-section">IoT मोनिटरिङ</div>
      <div class="sidebar-accordion accordion" id="iotAccordion">
        <div class="accordion-item bg-transparent border-0">
          <h2 class="accordion-header">
            <button class="accordion-button py-2" type="button" data-bs-toggle="collapse" data-bs-target="#iotMenu"
                    aria-expanded={activePage.startsWith('iot') ? 'true' : 'false'}>
              <i class="bi bi-router me-2"></i> IoT स्टेसन
            </button>
          </h2>
          <div id="iotMenu" class={`accordion-collapse collapse ${activePage.startsWith('iot') ? 'show' : ''}`} data-bs-parent="#iotAccordion">
            <div class="accordion-body">
              <a href="/iot" class={activePage === 'iot' ? 'active' : ''}><i class="bi bi-grid-1x2"></i> ड्यासबोर्ड</a>
              <a href="/iot" class="iot-devices-link"><i class="bi bi-router"></i> उपकरणहरू</a>
              <a href="/iot#cron" class="iot-cron-link"><i class="bi bi-clock-history"></i> क्रन एजेन्ट</a>
              <a href="/iot#alerts" class="iot-alerts-link"><i class="bi bi-exclamation-triangle"></i> सतर्कता</a>
            </div>
          </div>
        </div>
      </div>

      <ul class="sidebar-nav mt-2">
        <li><a href="/schemes" class={activePage === 'schemes' ? 'active' : ''}><i class="bi bi-bank"></i> योजनाहरू</a></li>
        <li><a href="/reports" class={activePage === 'reports' ? 'active' : ''}><i class="bi bi-bar-chart-line"></i> प्रतिवेदन</a></li>
        <li><a href="/settings" class={activePage === 'settings' ? 'active' : ''}><i class="bi bi-gear"></i> सेटिङ</a></li>
      </ul>
    </nav>
  </aside>
  <header class="topbar">
    <button class="btn btn-sm btn-outline-secondary d-lg-none me-3" onclick="document.getElementById('sidebar').classList.toggle('show')">
      <i class="bi bi-list"></i>
    </button>
    <div class="d-flex align-items-center justify-content-between w-100">
      <h6 class="mb-0 d-none d-md-block">{title}</h6>
      <div class="d-flex align-items-center gap-3">
        <span class="small" style="color:var(--text-secondary)">एडमिन</span>
        <div class="dropdown">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">Admin</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/settings">सेटिङ</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="#">लगआउट</a></li>
          </ul>
        </div>
      </div>
    </div>
  </header>
  <main class="main-content">
    <div class="p-4">
      <slot />
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
