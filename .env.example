# ── Default AI Provider ──
DEFAULT_PROVIDER=ollama           # "ollama" for local, "google_ai_studio" for api fallback

# ── Ollama Settings (Local) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma4:e2b

# ── Google AI Studio Settings ──
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_DEFAULT_MODEL=gemma-4-12b

# ── OpenRouter Settings (OCR Extraction) ──
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=google/gemma-4-31b-it

# ── Task-Specific Model Overrides (Optional) ──
GEMMA_MODEL=gemma4:e2b
VISION_MODEL=                      # e.g., gemma4:e2b (local) or gemma-4-12b (google)
AUDIO_MODEL=                       # e.g., gemma4:e2b
ROUTING_MODEL=                     # e.g., gemma4:e2b
REASONING_MODEL=                   # e.g., gemma-4-31b or gemma-2-27b-it

# ── Backend Settings ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# ── Frontend Settings ──
PUBLIC_API_URL=http://localhost:8000

# ── Weather API (Free key) ──
OPENWEATHER_API_KEY=your-openweather-key-here

# ── Database Path ──
DATABASE_ROOT=../database
